      <Paragraph Alignment="Center" Type="Action">
        <Text>O PAI DA MINHA MELHOR AMIGA</Text>
      </Paragraph>
      <Paragraph Alignment="Center" Type="Action">
        <Text></Text>
      </Paragraph>
      <Paragraph Alignment="Center" Type="Action">
        <Text>Novela vertical — comédia romântica</Text>
      </Paragraph>
      <Paragraph Alignment="Center" Type="Action">
        <Text>40 capítulos de 2 minutos</Text>
      </Paragraph>
      <Paragraph Alignment="Center" Type="Action">
        <Text></Text>
      </Paragraph>
